{
  "groups": [
    {
      "id": "apb_registers",
      "title": "APB 与寄存器",
      "items": [
        {
          "id": "apb_register_access",
          "title": "握手、DLAB 与地址镜像",
          "summary": "通过 APB 事务和协议断言检查建立/访问阶段、配置寄存器读回、DLAB 两套 bank、高位地址镜像及只读写忽略。",
          "checks": [
            {
              "suite_id": "uart_core",
              "tests": ["uart_smoke_test", "uart_address_mirror_test"],
              "variants": ["upstream", "fixed"]
            }
          ]
        }
      ]
    },
    {
      "id": "uart_data_fifo",
      "title": "UART 数据流与 FIFO",
      "items": [
        {
          "id": "uart_formats_streams",
          "title": "帧格式、波特周期与随机双向流",
          "summary": "检查 5～8 数据位、偶校验开关、1/2 停止位及 32/48/64 时钟位周期；多批双向流由独立引脚监视器和 Scoreboard 比对。",
          "checks": [
            {
              "suite_id": "uart_core",
              "tests": ["uart_baud_sweep_test", "uart_random_stress_test"],
              "variants": ["upstream", "fixed"]
            }
          ]
        },
        {
          "id": "fifo_boundary_clear_wrap",
          "title": "FIFO 满空、清空与回绕",
          "summary": "检查 TX FIFO 加发送器的 17 帧短突发、RX 16 帧填满后排空、指针回绕、非空 RX 清空及 TX 空闲清空后的恢复。",
          "checks": [
            {
              "suite_id": "uart_core",
              "tests": ["uart_fifo_boundary_test"],
              "variants": ["upstream", "fixed"]
            }
          ]
        },
        {
          "id": "tx_overflow_recovery",
          "title": "TX 满写丢弃与恢复",
          "summary": "在定向短突发中写入 21 帧，检查接受 17 帧、丢弃 4 帧及之后的新帧收发；容量预测和实际 TX 引脚帧数独立核对。",
          "checks": [
            {
              "suite_id": "uart_core",
              "tests": ["uart_tx_overflow_test"],
              "variants": ["upstream", "fixed"]
            }
          ]
        },
        {
          "id": "rx_retention_empty_read",
          "title": "RX 第 17 帧保留与空读",
          "summary": "检查 FIFO 满时接收器保留第 17 帧，读出释放空间后按序排出；另检查空 RBR 读取不下溢及后续新帧恢复。",
          "checks": [
            {
              "suite_id": "uart_core",
              "tests": ["uart_rx_retention_test", "uart_empty_read_test"],
              "variants": ["upstream", "fixed"]
            }
          ]
        }
      ]
    },
    {
      "id": "uart_status_reset",
      "title": "错误状态、中断与复位",
      "items": [
        {
          "id": "uart_error_injection",
          "title": "错误帧注入与行为表征",
          "summary": "独立串行监视器确认错误偶校验和低停止位，并比对载荷；修复版要求 PE/FE 上报，原版按已知缺失行为进行特征检查。",
          "checks": [
            {
              "suite_id": "uart_core",
              "tests": ["uart_error_test"],
              "variants": ["upstream", "fixed"]
            }
          ]
        },
        {
          "id": "uart_error_status_requirement",
          "title": "PE/FE 与 FIFO 队首关联严格需求",
          "summary": "严格检查 PE、FE，以及正常/错误/正常字节队列的 LSR 标记关联；STATUS 位检查与 RBR 数据比对职责分开，原版严格需求的原始 FAIL 保留。",
          "checks": [
            {
              "suite_id": "uart_core",
              "tests": ["uart_parity_requirement_test", "uart_framing_requirement_test", "uart_error_association_test"],
              "variants": ["upstream", "fixed"]
            }
          ]
        },
        {
          "id": "uart_interrupts",
          "title": "IRQ 门限、优先级与确认",
          "summary": "检查四档 RX 门限、IER 使能、来源优先级及读寄存器确认/重触发；特征测试保留原版行为，严格需求测试保留原版原始 FAIL。",
          "checks": [
            {
              "suite_id": "uart_core",
              "tests": ["uart_irq_test", "uart_irq_requirement_test"],
              "variants": ["upstream", "fixed"]
            }
          ]
        },
        {
          "id": "uart_reset_recovery",
          "title": "传输中复位与新帧恢复",
          "summary": "在串行帧传输期间异步复位，检查残帧取消、Scoreboard 预测清理、复位后状态及重新配置后的双向传输。",
          "checks": [
            {
              "suite_id": "uart_core",
              "tests": ["uart_reset_test"],
              "variants": ["upstream", "fixed"]
            }
          ]
        }
      ]
    },
    {
      "id": "uart_ral",
      "title": "RAL 专项",
      "items": [
        {
          "id": "ral_config_prediction",
          "title": "配置寄存器访问与寄存器组预测",
          "summary": "检查 IER/LCR/DLL/DLM 四寄存器的 frontdoor、镜像读回、DLAB 双 map、加锁访问、LCR 恢复和被动 bank 预测；结果与核心回归分开。",
          "checks": [
            {
              "suite_id": "uart_ral",
              "tests": ["uart_ral_test"],
              "variants": ["fixed"]
            }
          ]
        }
      ]
    },
    {
      "id": "apb_agent",
      "title": "独立 APB Agent",
      "items": [
        {
          "id": "apb_wait_reset_response",
          "title": "等待、错误响应与复位取消",
          "summary": "使用独立可编程从设备检查 0/1/3/7 等待、完成时读值、PSLVERR 写不提交、等待中异步复位及超时上限内的成功传输；UART 的 PREADY 恒为 1。",
          "checks": [
            {
              "suite_id": "apb_protocol",
              "tests": ["apb_wait_state_test", "apb_reset_abort_test", "apb_timeout_control_test"],
              "phases": ["positive"],
              "variants": ["agent"]
            }
          ]
        },
        {
          "id": "apb_timeout_detection",
          "title": "超时负向检出",
          "summary": "持续拉低 PREADY 触发唯一 APB_TIMEOUT，并检查激活、完成标记及随后恢复事务；该阶段保留原始 FAIL，审计另记 DETECTED。",
          "checks": [
            {
              "suite_id": "apb_protocol",
              "tests": ["apb_timeout_requirement_test"],
              "phases": ["negative"],
              "variants": ["agent"]
            }
          ]
        },
        {
          "id": "apb_clean_recovery",
          "title": "故障后的正常恢复对照",
          "summary": "超时负向阶段后，使用同一记录二进制再次执行正常等待测试，检查干净 PASS 和正常总线传输；与负向阶段分别统计。",
          "checks": [
            {
              "suite_id": "apb_protocol",
              "tests": ["apb_wait_state_test"],
              "phases": ["recovery"],
              "variants": ["agent"]
            }
          ]
        }
      ]
    },
    {
      "id": "checker_controls",
      "title": "检查器边界故障对照",
      "items": [
        {
          "id": "checker_fault_detection",
          "title": "四项指定故障检出",
          "summary": "对 TX/RX 数据翻转、PE 屏蔽和 IRQ 拉低四项边界故障，分别要求 TX_MISMATCH、RX_MISMATCH、STATUS、IRQ；原始 FAIL 与审计 DETECTED 分列。",
          "checks": [
            {
              "suite_id": "fault_control",
              "tests": ["uart_smoke_test", "uart_parity_requirement_test", "uart_irq_requirement_test"],
              "phases": ["mutation"],
              "variants": ["fixed"]
            }
          ]
        },
        {
          "id": "checker_clean_controls",
          "title": "注入前后正常对照",
          "summary": "使用同一记录二进制和 seed 1，在指定故障注入前后分别执行 smoke、PE 严格需求和 IRQ 严格需求，要求无故障控制正常通过。",
          "checks": [
            {
              "suite_id": "fault_control",
              "tests": ["uart_smoke_test", "uart_parity_requirement_test", "uart_irq_requirement_test"],
              "phases": ["control_before", "control_after"],
              "variants": ["fixed"]
            }
          ]
        }
      ]
    }
  ]
}
